# ==========================================
# REGION & CROSS-REGION SYNC CONFIGURATION
# ==========================================
# Local Cluster: ap-south-local | AWS EC2: aws-us-east-1
REGION_ID=ap-south-local

# URL of the opposite region's NGINX edge proxy for real-time Kafka ticket replication
# Example on Local: http://54.162.88.10
# Example on AWS EC2: https://pulse-india-demo.trycloudflare.com
PEER_REGION_URL=

# Shared secret header to authenticate cross-region webhook events
RELAY_SECRET=pulsetix-sync-secret-2026

# ==========================================
# TIER 3: DATABASE & MESSAGE BROKER SECRETS
# ==========================================
POSTGRES_USER=pulsetix
POSTGRES_PASSWORD=pulsetix_secret
POSTGRES_DB=pulsetix_db

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
